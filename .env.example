# Optional overrides. Leave blank until the values are confirmed.
# Do not invent contact details or point these at a live service that is not ready.

# Canonical site origin, without a trailing slash.
VITE_SITE_URL=https://vividworks.my

# Official contact email. When set, a saved inquiry can also be opened in a mail app.
# The form does not send email by itself.
VITE_CONTACT_EMAIL=

# Server. Leave DATABASE_URL empty locally to store inquiries in data/inquiries.json.
# On Northflank, the template aliases the Postgres POSTGRES_URI to DATABASE_URL.
DATABASE_URL=
# Set to false when the database URL is remote but does not speak TLS.
DATABASE_SSL=
# Required before GET /api/inquiries responds. Generate this in Northflank; do not commit it.
ADMIN_TOKEN=
# API listen port. npm start uses PORT. npm run dev keeps the API on API_PORT.
# The Northflank container listens on 8080.
PORT=8787
API_PORT=8787
# Team API token for the Northflank MCP server. Never commit the real value.
NORTHFLANK_API_TOKEN=

# Future SaaS URLs. Absolute http(s) URLs only.
# While empty, login, registration and template actions stay on the Akan Datang page.
VITE_SAAS_LOGIN_URL=
VITE_SAAS_REGISTER_URL=
VITE_SAAS_EDITOR_URL=
