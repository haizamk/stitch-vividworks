APP_NAME=vividworks-my
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8790

# Local values above stay on loopback.
# Coolify staging on Monalisa overrides them in the service environment, not in this file:
# APP_ENV=staging
# APP_DEBUG=false
# APP_URL=https://<coolify-staging-hostname>
# APP_KEY is produced once by `php artisan key:generate --show` and stored only as a Coolify secret.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Coolify staging uses LOG_CHANNEL=stderr and LOG_LEVEL=info.
# The stderr channel is defined in config/logging.php and shows up in the Coolify log stream.

# PostgreSQL. Do not commit a password, and do not run migrations against the preview database.
# DB_URL wins when it is set. DATABASE_URL is accepted as a fallback so the Express variable can be reused later.
# Coolify staging uses a new Supabase project: DB_CONNECTION=pgsql, DB_SSLMODE=require,
# and DB_URL on port 5432 (direct host db.<project-ref>.supabase.co, or the session pooler).
# Do not use the transaction pooler on port 6543. Do not point DB_URL at preview or production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
DB_URL=
DATABASE_URL=

# Coolify staging must not set DB_DDL_*, DB_TIER_B_*, VV_ALLOW_TIER_A_PG_DDL, or VV_ALLOW_TIER_B_DEFINER_DESTRUCTIVE_TESTS.
# Batch 4B-1 Tier A: dedicated PostgreSQL TEST cluster for ephemeral role DDL (pgsql_ddl).
# All DB_DDL_* values must be set; Laravel does not fall back to DB_* for destructive DDL tests.
# Set VV_ALLOW_TIER_A_PG_DDL=true only on disposable local/CI test infrastructure (never production).
# DB_DDL_URL=
# DB_DDL_HOST=
# DB_DDL_PORT=5432
# DB_DDL_DATABASE=
# DB_DDL_USERNAME=
# DB_DDL_PASSWORD=
# DB_DDL_SSLMODE=disable
# VV_ALLOW_TIER_A_PG_DDL=false

# Batch 4B-1 Tier B: second PostgreSQL instance/cluster for definer negative verification (pgsql_tier_b).
# Must use a different system_identifier than pgsql / pgsql_ddl (separate instance, not a second database).
# Set VV_ALLOW_TIER_B_DEFINER_DESTRUCTIVE_TESTS=true only on isolated test clusters.
# DB_TIER_B_URL=
# DB_TIER_B_HOST=
# DB_TIER_B_PORT=5434
# DB_TIER_B_DATABASE=
# DB_TIER_B_USERNAME=
# DB_TIER_B_PASSWORD=
# DB_TIER_B_SSLMODE=disable
# VV_ALLOW_TIER_B_DEFINER_DESTRUCTIVE_TESTS=false

# Empty means GET /api/inquiries stays hidden (HTTP 404). Generate a value outside git.
ADMIN_TOKEN=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Coolify staging keeps QUEUE_CONNECTION=sync, CACHE_STORE=file, SESSION_DRIVER=file, and FILESYSTEM_DISK=local.
# Do not set REDIS_* on that service. Do not set CACHE_STORE=database or QUEUE_CONNECTION=database.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staging/production with Resend: MAIL_MAILER=resend and RESEND_API_KEY in the runtime env only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
