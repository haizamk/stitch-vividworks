{
  "$schema": "https://api.northflank.com/v1/schemas/template",
  "apiVersion": "v1.2",
  "arguments": {
    "HEALTH_PATH": "/api/health"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "vividworks",
            "description": "Marketing site and contact inquiries for vividworks.my",
            "region": "asia-southeast",
            "networking": {
              "allowedIngressProjects": []
            }
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "database",
                "spec": {
                  "name": "vividworks-db",
                  "description": "PostgreSQL 16 for contact inquiries",
                  "type": "postgresql",
                  "version": "16-latest",
                  "tlsEnabled": true,
                  "externalAccessEnabled": false,
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storage": 4096,
                    "replicas": 1
                  }
                }
              },
              {
                "kind": "CombinedService",
                "ref": "web",
                "spec": {
                  "name": "vividworks-web",
                  "description": "React site and contact API",
                  "billing": {
                    "deploymentPlan": "nf-compute-10",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "vcsData": {
                    "projectType": "${args.VCS_PROVIDER}",
                    "projectUrl": "${args.REPOSITORY_URL}",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    },
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 8080,
                      "protocol": "HTTP",
                      "public": true,
                      "disableNfDomain": false
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "startupProbe",
                      "path": "${args.HEALTH_PATH}",
                      "initialDelaySeconds": 5,
                      "periodSeconds": 10,
                      "timeoutSeconds": 5,
                      "failureThreshold": 18
                    },
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "${args.HEALTH_PATH}",
                      "initialDelaySeconds": 5,
                      "periodSeconds": 15,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3
                    }
                  ],
                  "runtimeEnvironment": {
                    "PORT": "8080",
                    "NODE_ENV": "production"
                  },
                  "disabledCI": false
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "secrets",
                "spec": {
                  "name": "vividworks-secrets",
                  "description": "Database URL and inquiry admin token",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "ADMIN_TOKEN": "${args.ADMIN_TOKEN}",
                      "DATABASE_SSL": "true"
                    }
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.database.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": ["DATABASE_URL"]
                        }
                      ]
                    }
                  ],
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "Workflow",
                "spec": {
                  "type": "parallel",
                  "steps": [
                    {
                      "kind": "Condition",
                      "spec": {
                        "kind": "Addon",
                        "spec": {
                          "type": "running",
                          "data": {
                            "addonId": "${refs.database.id}",
                            "timeoutDuration": 1200
                          }
                        }
                      }
                    },
                    {
                      "kind": "Condition",
                      "spec": {
                        "kind": "Service",
                        "spec": {
                          "type": "running",
                          "data": {
                            "serviceId": "${refs.web.id}",
                            "timeoutDuration": 1800
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "kind": "Action",
                "spec": {
                  "kind": "Service",
                  "spec": {
                    "type": "restart",
                    "data": {
                      "serviceId": "${refs.web.id}"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
